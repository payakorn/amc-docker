# Copy to .env and edit. Compose reads .env automatically.
# ---------------------------------------------------------------------------

# REQUIRED. The exam repository on the Mac, mounted at /work/repo in the
# container. Use an absolute path — "~" is not expanded here by Compose.
EXAM_REPO=/Users/payakorn/projects/888102

# Which folder inside that repo holds the AMC projects. For 888102 the
# projects live in exam/ (888102-mt, midterm-amc, ...). For a repo whose
# projects sit at the top level, use "."
AMC_PROJECTS_SUBDIR=exam

# Default LaTeX engine for NEW projects. 888102's exam is pdflatex (tgtermes,
# ASCII only); the Thai exams need xelatex. Per-project settings win over this.
AMC_LATEX_ENGINE=pdflatex

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# VNC/noVNC password. Change it. Used by both the browser client and macOS
# Screen Sharing.
VNC_PASSWORD=amc2026

# Desktop resolution. Roughly match the browser window you will use; noVNC can
# also resize the remote desktop to fit once connected.
VNC_GEOMETRY=1600x1000

# 127.0.0.1 = reachable only from the Mac mini itself. Set to 0.0.0.0 to reach
# it from other machines on the LAN — but VNC traffic is not encrypted, so
# prefer Tailscale or a Cloudflare Tunnel over opening it up.
BIND_ADDR=127.0.0.1
NOVNC_PORT=6080
VNC_PORT=5901

# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

GIT_USER_NAME=Payakorn Saksuriya
GIT_USER_EMAIL=payakornn@gmail.com

# SSH keys used for git push. Absolute path.
SSH_DIR=/Users/payakorn/.ssh

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# 1 = open AMC automatically when the desktop starts; 0 = plain desktop.
AMC_AUTOSTART=1

# File ownership for the mounted repo. Irrelevant on macOS (Docker Desktop
# maps it), matters when hosting on a Linux box: set to your `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000
