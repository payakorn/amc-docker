# Copy to .env and edit. Compose reads .env automatically.
# ---------------------------------------------------------------------------

# REQUIRED. The exam repository on the Mac, mounted at /work/repo in the
# container. Use an absolute path — "~" is not expanded here by Compose.
EXAM_REPO=/Users/<you>/projects
# Windows: forward slashes, e.g. EXAM_REPO=C:/Users/<you>/projects

# Which folder inside that repo holds the AMC projects. For 888102 the
# projects live in exam/ (888102-mt, midterm-amc, ...). For a repo whose
# projects sit at the top level, use "."
AMC_PROJECTS_SUBDIR=.

# Default LaTeX engine for NEW projects. 888102's exam is pdflatex (tgtermes,
# ASCII only); the Thai exams need xelatex. Per-project settings win over this.
AMC_LATEX_ENGINE=xelatex

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# VNC/noVNC password. Change it. Used by both the browser client and macOS
# Screen Sharing.
VNC_PASSWORD=change-me

# Desktop resolution. Roughly match the browser window you will use; noVNC can
# also resize the remote desktop to fit once connected.
VNC_GEOMETRY=1600x1000

# Who can reach the ports.
#
#   127.0.0.1   this machine only (default)
#   0.0.0.0     every machine on the LAN — colleagues, your laptop, a phone
#   192.168.x.y one interface only, e.g. the wired LAN but not the guest wifi
#
# On 0.0.0.0 the container insists on a web token (generating and printing one
# if AMC_WEB_TOKEN is empty) because the web interface runs commands and writes
# to the exam repo. Nothing here is encrypted, so use it on a network you
# trust; across the internet, use Tailscale or a Cloudflare Tunnel instead.
BIND_ADDR=127.0.0.1

# The web interface's own bind address, so the batch workflow can go out onto
# the LAN without also exposing unencrypted VNC. Same values as BIND_ADDR
# above; defaults to BIND_ADDR if left empty.
WEB_BIND_ADDR=

# Ports on the host. These are the numbers you type in a browser and the ones
# to open in a firewall; inside the container the services always listen on
# 8080/6080/5901 regardless.
#
# WEB_PORT is the one that matters — the whole batch workflow is there, and it
# is the only one that needs opening unless you want the desktop too.
#
# 609x, not 60xx: 6000-6063 is the X11 display range, and 6080 is what noVNC
# listens on inside the container, so keeping the host numbers off both means a
# port number never means two things at once. (macOS AirPlay Receiver, for the
# record, is 7000/7001 — neither range collides with it.)
WEB_PORT=6090
NOVNC_PORT=6091
VNC_PORT=6092

# The web interface (http://localhost:6090/): question editing, checks,
# compiling, capture, marking, export. 0 = desktop only.
AMC_WEB=1

# Shared secret for the web interface. Empty means no check, which is fine
# while BIND_ADDR is 127.0.0.1. With BIND_ADDR opened up, leaving this empty
# makes the container generate a token at first start, keep it in the amc-home
# volume and print it in `docker compose logs`; set your own here to skip that.
AMC_WEB_TOKEN=

# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# SSH keys used for git push. Absolute path.
SSH_DIR=/Users/<you>/.ssh
# Windows: SSH_DIR=C:/Users/<you>/.ssh   (create the folder if it does not exist)

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# 1 = open AMC automatically when the desktop starts; 0 = plain desktop.
AMC_AUTOSTART=1

# File ownership for the mounted repo. Irrelevant on macOS (Docker Desktop
# maps it), matters when hosting on a Linux box: set to your `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000
