#!/bin/bash
# Prove the container actually works, rather than merely starting.
#
# Run it after the first build, and after any change to the Dockerfile:
#
#   docker compose exec amc amc-selftest
#
# It checks the three things that can each be silently broken — the tool chain
# (AMC, LaTeX, the VNC stack), the wiring (repo mount, git, projects dir), and
# the pipeline itself: it compiles a throwaway two-copy exam with AMC's command
# line and loads the resulting layout into a database, which is exactly what
# the GUI's "Update documents" does.
#
#   amc-selftest          full run
#   amc-selftest -q       skip the compile, just check what is installed
#
# Exit status is 0 only if every required check passed. Checks marked [warn]
# are informational and never fail the run.

set -uo pipefail

quick=0
[ "${1:-}" = "-q" ] && quick=1

pass=0; fail=0; warn=0

ok()   { printf '  \033[32mok\033[0m    %s\n' "$1"; pass=$((pass + 1)); }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; fail=$((fail + 1)); }
note() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; warn=$((warn + 1)); }
head_() { printf '\n\033[1m%s\033[0m\n' "$1"; }

have() {
  if out=$(command -v "$1" 2>/dev/null); then ok "$1 ($out)"; else bad "$1 not found"; fi
}

# ---------------------------------------------------------------------------
head_ "Tool chain"
# ---------------------------------------------------------------------------
have auto-multiple-choice
have pdflatex
have xelatex
have git
have python3
have Xtigervnc
have tigervncpasswd
have websockify
have xdpyinfo

# The wrappers the web interface drives. A missing one turns a button in the
# browser into an unexplained failure, so check they are all installed.
for w in amc-opts amc-compile amc-capture amc-mark amc-export amc-status \
         amc-check amc-save amc-project-init; do
  have "$w"
done

if [ -x /opt/amc-web/.venv/bin/uvicorn ]; then
  if /opt/amc-web/.venv/bin/python -c 'import fastapi, uvicorn, multipart' 2>/dev/null; then
    ok "web interface dependencies (fastapi, uvicorn, multipart)"
  else
    bad "web interface venv is incomplete" "rebuild the image: docker compose build --no-cache"
  fi
else
  note "web interface not installed" "only the desktop is available; set AMC_WEB=1 and rebuild"
fi

if command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; then
  ok "ImageMagick present"
else
  bad "neither magick nor convert found" "AMC needs ImageMagick to turn scanned PDFs into page images"
fi

# Ask the package manager, not AMC itself: `auto-multiple-choice` with an
# argument it does not recognise falls through to launching the GUI, which
# blocks forever in a non-interactive shell.
amc_version=$(dpkg-query -W -f='${Version}' auto-multiple-choice 2>/dev/null)
[ -n "$amc_version" ] && printf '        AMC version: %s\n' "$amc_version"

sty=$(kpsewhich automultiplechoice.sty 2>/dev/null)
if [ -n "$sty" ]; then
  ok "automultiplechoice.sty found ($sty)"
else
  bad "automultiplechoice.sty not on the LaTeX search path" \
      "run mktexlsr as root in the container, then rebuild the image"
fi

for pkg in pgfplots.sty tgtermes.sty multicol.sty amsmath.sty; do
  if kpsewhich "$pkg" >/dev/null 2>&1; then ok "$pkg"; else bad "$pkg missing" "add the Debian texlive package that ships it"; fi
done

# ---------------------------------------------------------------------------
head_ "Desktop and remote access"
# ---------------------------------------------------------------------------
if xdpyinfo -display :1 >/dev/null 2>&1; then
  geom=$(xdpyinfo -display :1 2>/dev/null | awk '/dimensions:/{print $2; exit}')
  ok "X server on :1 (${geom:-unknown})"
else
  bad "no X server on :1" "check: docker compose logs amc"
fi

if pgrep -x xfwm4 >/dev/null 2>&1 || pgrep -f xfce4-session >/dev/null 2>&1; then
  ok "XFCE session running"
else
  note "XFCE session not detected" "the desktop may still be starting"
fi

if curl -fsS -o /dev/null --max-time 5 http://localhost:6080/vnc.html 2>/dev/null; then
  ok "noVNC serving on 6080"
else
  bad "noVNC not answering on 6080" "websockify may have died — check the container log"
fi

if timeout 3 bash -c 'exec 3<>/dev/tcp/localhost/5901' 2>/dev/null; then
  ok "VNC accepting connections on 5901"
else
  bad "nothing listening on 5901"
fi

web_port=${AMC_WEB_PORT:-8080}
if [ "${AMC_WEB:-1}" = "1" ]; then
  if curl -fsS --max-time 5 "http://localhost:${web_port}/healthz" >/dev/null 2>&1; then
    ok "web interface answering on ${web_port}"
    # A 401 here is the correct answer when a token is set, and it still
    # proves the app is routing requests rather than merely listening.
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://localhost:${web_port}/api/projects" 2>/dev/null)
    case "$code" in
      200) ok "web interface can list projects" ;;
      401) ok "web interface requires its token (AMC_WEB_TOKEN is set)" ;;
      *)   bad "web interface returned HTTP $code for /api/projects" "check: docker compose logs amc" ;;
    esac
  else
    bad "web interface not answering on ${web_port}" "uvicorn may have died — check: docker compose logs amc"
  fi
else
  printf '  skipped  web interface (AMC_WEB=0)\n'
fi

# ---------------------------------------------------------------------------
head_ "Wiring"
# ---------------------------------------------------------------------------
repo=${AMC_REPO:-/work/repo}
projects=${AMC_PROJECTS_DIR:-$repo/exam}

if [ -d "$repo" ] && [ -n "$(ls -A "$repo" 2>/dev/null)" ]; then
  ok "exam repo mounted at $repo"
else
  bad "$repo is missing or empty" "check EXAM_REPO in .env (default ./exams)"
fi

if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
  branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
  ok "git works in the mounted repo (branch: $branch)"
else
  bad "git cannot read $repo" "'dubious ownership' means safe.directory was not applied"
fi

if [ -w "$repo" ]; then ok "repo is writable"; else bad "repo is read-only" "AMC cannot write compiled PDFs there"; fi

if [ -d "$projects" ]; then
  n=$(find "$projects" -maxdepth 2 -name options.xml 2>/dev/null | wc -l)
  ok "projects directory $projects ($n project(s) AMC can open)"
  [ "$n" = 0 ] && note "no project has an options.xml yet" "run: amc-project-init $projects/<folder>"
else
  bad "projects directory $projects does not exist" "check AMC_PROJECTS_SUBDIR in .env"
fi

if [ -f "$HOME/.AMC.d/cf.default.xml" ]; then ok "AMC preferences seeded"; else bad "AMC preferences missing"; fi

ssh_out=$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -T git@github.com 2>&1)
if printf '%s' "$ssh_out" | grep -q 'successfully authenticated'; then
  ok "GitHub SSH authentication works ($(printf '%s' "$ssh_out" | sed 's/.*Hi \([^!]*\)!.*/\1/'))"
else
  note "GitHub SSH not authenticated" "amc-save cannot push; key passphrases need an interactive terminal. Detail: ${ssh_out%%$'\n'*}"
fi

if fc-list 2>/dev/null | grep -qi sarabun; then
  ok "a TH Sarabun font is installed (Thai exams)"
else
  note "no TH Sarabun font" "only needed for Thai exams — see fonts/README.md"
fi

# ---------------------------------------------------------------------------
head_ "Pipeline"
# ---------------------------------------------------------------------------
if [ "$quick" = 1 ]; then
  printf '  skipped (-q)\n'
else
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/data"

  cat > "$tmp/source.tex" <<'TEX'
\documentclass[a4paper]{article}
\usepackage[T1]{fontenc}
\usepackage[box,completemulti,separateanswersheet]{automultiplechoice}
\begin{document}
\onecopy{2}{
\noindent\AMCcode{student}{6}\hspace*{\fill}
\begin{question}{selftest}
Two plus two?
\begin{choices}
\correctchoice{4}\wrongchoice{3}\wrongchoice{5}\wrongchoice{22}
\end{choices}
\end{question}
\AMCcleardoublepage
\AMCformBegin
\AMCform
}
\end{document}
TEX

  log=$tmp/prepare.log
  # timeout + </dev/null: a LaTeX error can leave pdflatex sitting at its
  # interactive prompt, and that would otherwise hang the whole self-test.
  if (cd "$tmp" && timeout 300 auto-multiple-choice prepare --mode s --n-copies 2 --with pdflatex \
        --data ./data --out-sujet sujet.pdf --out-corrige corrige.pdf \
        --out-calage calage.xy source.tex </dev/null) > "$log" 2>&1 && [ -s "$tmp/sujet.pdf" ]; then
    pages=$(pdfinfo "$tmp/sujet.pdf" 2>/dev/null | awk '/^Pages:/{print $2}')
    ok "AMC compiled a 2-copy exam (${pages:-?} pages)"
  else
    bad "AMC could not compile the test exam" "last lines of the log:"
    tail -12 "$log" | sed 's/^/        /'
  fi

  if [ -s "$tmp/calage.xy" ]; then
    if (cd "$tmp" && timeout 120 auto-multiple-choice meptex --src calage.xy --data ./data </dev/null) >>"$log" 2>&1; then
      counts=$(python3 - "$tmp/data/layout.sqlite" <<'PY' 2>/dev/null
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
p = c.execute("select count(*) from layout_page").fetchone()[0]
b = c.execute("select count(*) from layout_box").fetchone()[0]
print(f"{p} pages, {b} boxes")
PY
)
      if [ -n "$counts" ]; then
        ok "layout database built ($counts)"
      else
        bad "layout database is unreadable"
      fi
    else
      bad "meptex failed to load the layout" "scan capture would fail the same way"
    fi
  fi

  # Does ImageMagick's policy actually allow PDF? Test it rather than trust it.
  if [ -s "$tmp/sujet.pdf" ]; then
    im=$(command -v magick || command -v convert)
    if "$im" -density 50 "$tmp/sujet.pdf[0]" "$tmp/page.png" >/dev/null 2>&1 && [ -s "$tmp/page.png" ]; then
      ok "ImageMagick can rasterize a PDF (scan capture will work)"
    else
      bad "ImageMagick refuses to read PDF" \
          "the policy.xml fix did not apply — rebuild with: docker compose build --no-cache"
    fi
  fi
fi

# ---------------------------------------------------------------------------
printf '\n\033[1mSummary\033[0m\n  %d passed, %d failed, %d warnings\n\n' "$pass" "$fail" "$warn"
if [ "$fail" = 0 ]; then
  printf 'Container is healthy. Open http://localhost:6080/\n'
  exit 0
fi
printf 'Fix the FAIL lines above before using this for a real exam.\n'
exit 1
